# ---- Web UI ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Two-step sign-in (authenticator app) and passkeys are set up on the
# Security page. Passkeys need HTTPS on a domain name (or localhost).
# How long a sign-in lasts, in days since the last visit.
SESSION_DAYS=30
# Behind a reverse proxy: trust X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false
# Lost your authenticator AND recovery codes? Start once with this set to
# true to remove two-step sign-in and passkeys, then set it back.
AUTH_RESET=false
# Public URL Plex uses to reach BackTrackarr (used to show the webhook URL)
BASE_URL=http://192.168.1.10:8787
# Secret path segment for the Plex webhook. Leave empty to auto-generate (shown on the Sync page).
WEBHOOK_TOKEN=
TZ=America/New_York
LOG_LEVEL=info

# ---- Plex ----
# Optional but recommended: lets BackTrackarr look up show IDs, import history,
# and poll sessions if you don't have Plex Pass.
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=
# Set to e.g. 10 to poll sessions instead of using webhooks (no Plex Pass needed).
PLEX_POLL_SECONDS=0
# Plex usernames whose plays are sent to external services (comma-separated).
# Empty = server owner only. All users' plays are stored locally regardless.
SCROBBLE_USERS=
WATCHED_PERCENT=80
# Libraries (by name, comma-separated) whose plays are stored locally but never
# sent anywhere (Trakt, Simkl, relays...), e.g. adult libraries.
PRIVATE_LIBRARIES=

# ---- Plex archive (read-only backup of metadata, playlists, collections) ----
# Minutes between incremental archives (0 = off). A full sweep runs daily.
PLEX_ARCHIVE_MINUTES=60
# Seconds between checks for "Mark as watched" presses (0 = off).
PLEX_WATCH_SCAN_SECONDS=300
# Also cover shared and managed users (reads their tokens from plex.tv).
PLEX_ALL_USERS=true
# BackTrackarr never changes Plex unless this is true. Needed only for restoring to a
# new server and copying playlists between users; both run only on a button press.
PLEX_ALLOW_WRITES=false

# ---- Trakt ----  https://trakt.tv/oauth/applications  (redirect uri: urn:ietf:wg:oauth:2.0:oob)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# ---- Simkl ----  https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=

# ---- Floppy ----  Settings -> Integrations -> API Token
FLOPPY_URL=
FLOPPY_TOKEN=

# ---- Plex webhook relays (comma-separated) ----
# Forwards every Plex webhook to services that accept Plex webhooks, e.g.
#   Floppy/Yamtrack:  http://floppy:8000/webhook/plex/<token>
#   CrossWatch:       its Plex webhook URL from CrossWatch settings
#   Trakt's own Plex scrobbler (VIP): the URL from trakt.tv/settings/scrobblers
RELAY_URLS=

# ---- Generic JSON webhooks (comma-separated): n8n, Home Assistant, custom scripts ----
WEBHOOK_URLS=

# ---- Streaming services (Netflix, Disney+, Hulu, Prime Video, Max...) ----
# They have no public API: plays come from history exports, the browser
# userscript, Jellyfin/Emby, or Trakt/Simkl pulls (see the Streaming page).
# A free TMDB key (themoviedb.org -> Settings -> API) matches titles to ids;
# without it, Trakt's search is used when TRAKT_CLIENT_ID is set.
TMDB_API_KEY=
# Where-to-watch region for recommendations, and your subscriptions.
STREAMING_REGION=US
MY_STREAMING_SERVICES=Netflix,Disney Plus,Hulu,Amazon Prime Video
# Pull new plays from connected Trakt/Simkl accounts every N minutes (0 = off).
TRACKER_PULL_MINUTES=60
# Local user for pulled and streaming plays (default: Plex owner).
TRACKER_PULL_USER=
# STREAMING_IMPORT_DIR=/data/import/streaming

# ---- Jellyfin / Emby: copy Plex playlists there (e.g. for Pleazy) ----
# To scrobble FROM Jellyfin/Emby, use the webhook URLs on the Streaming page.
# Add JELLYFIN_2_URL ... for more servers. API key: Dashboard -> API Keys.
JELLYFIN_URL=
JELLYFIN_API_KEY=
EMBY_URL=
EMBY_API_KEY=

# ---- Sonarr / Radarr / Whisparr (any number: SONARR_2_URL, RADARR_3_URL...) ----
# Archived every ARR_ARCHIVE_HOURS; recommendations can be added to them.
# Optional per instance: _NAME, _ADULT=true, _ROOT_FOLDER, _QUALITY_PROFILE.
# Whisparr instances are always treated as adult.
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
# RADARR_2_URL=http://radarr4k:7878
# RADARR_2_API_KEY=
# RADARR_2_NAME=radarr-4k
WHISPARR_URL=
WHISPARR_API_KEY=
ARR_ARCHIVE_HOURS=12

# ---- AI recommendations (your own keys; titles and ratings are sent to them) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# Default for the "include adult" box (also uses private-library plays).
AI_INCLUDE_ADULT=false

# ---- Comics ----  CLZ Comics CSV exports dropped here are imported hourly
# CLZ_IMPORT_DIR=/data/import/clz

# ---- Backups ----  daily snapshots kept in /data/backups
BACKUP_KEEP=7
# gzip snapshots (a 5 GB database becomes roughly 1-2 GB per backup).
BACKUP_COMPRESS=true
